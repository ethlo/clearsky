# Copy to .env (or ~/.config/clearsky/.env) and fill in. Never commit .env.

# GitHub: leave GITHUB_TOKEN empty to use the GitHub CLI's login (`gh auth token`), or set
# a fine-grained or classic token with read access to your work repos
# (Pull requests: read, Issues: read, Contents: read, Metadata: read).
GITHUB_TOKEN=
# Comma-separated orgs to include. Leave empty to search everything the token can see.
GITHUB_ORGS=
# For GitHub Enterprise Server: https://github.example.com/api/v3
# GITHUB_API_URL=https://api.github.com

# Jira goes through the Atlassian CLI (acli). Log in once with:
#   acli jira auth login --web
# Optional: path to acli if it is not on PATH.
# ACLI_BIN=acli
# Optional: base URL for links; by default it is taken from acli's output.
# JIRA_URL=https://yourcompany.atlassian.net
# Optional: your Jira account id; by default it is looked up from an issue you are assigned to.
# JIRA_ACCOUNT_ID=

# Google Calendar (optional): Settings > your calendar > Integrate calendar >
# "Secret address in iCal format". Treat it like a password.
# CALENDAR_ICS_URL=
# Your calendar email, so events you declined are left out.
# CALENDAR_EMAIL=
# When your workday ends (local time), for the Now / Next free-time estimate.
# CLEARSKY_WORKDAY_END=17:00

# Slack (optional): a user token (xoxp-...) with the search:read user scope.
# See README.md, "Slack token", for the two-minute setup.
# SLACK_TOKEN=

# Optional tuning
# CLEARSKY_MENTION_DAYS=14
# CLEARSKY_IGNORE_AUTHORS=dependabot[bot],renovate[bot]
# CLEARSKY_PORT=7777
# CLEARSKY_CACHE_SECONDS=120
# JIRA_ASSIGNED_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY priority DESC, updated DESC
# JIRA_MENTIONS_JQL=updated >= -14d AND (comment ~ currentUser() OR watcher = currentUser())
